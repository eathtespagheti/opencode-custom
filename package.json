{
  "name": "opencode-custom",
  "version": "1.0.0",
  "description": "Installable plugin for OpenCode customizations: docs-keeping (docs-keeper agent + docs-sync skill), unattended overnight mode, gitlab-issue-board, and obsidian/json-canvas skills.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./tui": "./tui.js",
    "./rpc": "./rpc.js"
  },
  "scripts": {
    "build": "node scripts/build-tui.mjs",
    "test": "node test/plugin.test.mjs && python3 test/docs-sync.test.py"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "babel-preset-solid": "^1.9.16"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "skills",
    "unattended",
    "gitlab"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/eathtespagheti/opencode-custom.git"
  }
}
